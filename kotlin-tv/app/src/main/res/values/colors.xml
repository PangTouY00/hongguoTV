<?xml version="1.0" encoding="utf-8"?>
<!-- 这一组值与 TvStyle.kt 是同一套配色：那边供代码里动态绘制的控件用，这里供主题与 drawable 用。
     改配色时两处都要改；TvStyle 顶部注释指向本文件。 -->
<resources>
    <color name="background">#070B12</color>
    <color name="accent">#FF8964</color>
    <color name="text">#F1F3F7</color>
    <color name="muted">#8E9BB0</color>
    <!-- 对话框与自绘面板的背景：同一张洗底上盖一层深色玻璃（见 drawable/tv_backdrop_panel.xml）。
         不透明度 .40 是按实机截图定下来的：.80 时面板最亮处 (13,14,25)、最暗处 (6,10,17)，只差 7 级亮度，
         电视上看不出任何光斑，等于还是贴了一块实色板。.40 时同一处是 (26,19,40) 对 (5,9,16)，
         墙的明暗走向看得出来，而面板仍比被压暗的弹窗背景亮一档，弹窗浮得起来。
         正文 #F1F3F7 对混合后的面板 16.2:1（光斑最亮处）到 18.0:1（最暗处），次要文字 #8E9BB0 最低 6.4:1，
         都比原来那块 .95 实色板还高，所以降透明度没有牺牲可读性。玻璃色取 #070B12，和界面底色同一个值，
         压暗是中性的，不会给面板加出第三种颜色。 -->
    <color name="panel_wash">#66070B12</color>
    <color name="dialog_edge">#4A8FA6C4</color>
</resources>
