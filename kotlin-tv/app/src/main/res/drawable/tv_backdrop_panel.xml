<?xml version="1.0" encoding="utf-8"?><!-- 弹窗与自绘面板的背景：同一张洗底 + 一层深色玻璃。
     为什么不是直接用 @drawable/tv_backdrop：弹窗里的正文要落在一个够实的面板上，纯洗底在光斑亮的地方
     会把对比拉下来。这里把洗底铺在最底层，再盖一层 @color/panel_wash（不透明度 .80）——面板仍然够实、
     文字对比不随身后画面变化，但面板本身带着和主界面一致的光斑走向，不再是贴上去的一块实色板。
     圆角与描边和 TvStyle.panel 一致（12dp / 1px 亮边）。改洗底改 tools/gen-backdrop.py 重新生成，别手改这里。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/tv_backdrop" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_wash" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/dialog_edge" />
        </shape>
    </item>
</layer-list>
